# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEBHOOK_URL: Optional Google Apps Script / Google Sheets webhook URL to automatically append new user signups directly into a Google Sheet in real time.
GOOGLE_SHEETS_WEBHOOK_URL=""

# ADMIN_EXPORT_TOKEN: Optional. When set, protects the private user export routes.
# Supply this value in the x-admin-token header or as a Bearer token.
ADMIN_EXPORT_TOKEN=""

# ADMIN_PASSKEY: Required to use the admin console. There is no default and no
# fallback — leave it empty and every /api/admin route stays closed. Send it as
# the x-admin-key header. Generate one with: openssl rand -hex 24
ADMIN_PASSKEY=""

# OWNER_PASSWORD: Password for the seeded owner account (the address in
# ADMIN_EMAILS). Set it to sign in as the owner with email and password; when
# set it wins over any password already stored, so it is also how you get back
# in. Leave empty and the account keeps its stored password, or none. Use 12+
# characters — it protects an administrator. DEMO_ACCOUNT_PASSWORD is the older
# name for the same thing and still works.
# (The landing page's demo button uses a separate shared account with no password.)
OWNER_PASSWORD=""

# REQUIRE_LOGIN_OTP: Set to "true" to ask for a six-digit code emailed to the
# account after a password or Google sign-in. Off by default.
# SESSION_SECRET: Signs the session cookie. At least 32 characters. Without it
# a random secret is generated per boot, so every restart signs everyone out.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

REQUIRE_LOGIN_OTP="false"

# OTP_WEBHOOK_URL: Where to POST { email, code, expiresAt } so the code is
# actually emailed. Any provider API, serverless function or workflow tool.
# With REQUIRE_LOGIN_OTP on and nothing configured here, sign-in fails closed
# rather than skipping the step.
OTP_WEBHOOK_URL=""

# OTP_WEBHOOK_TOKEN: Optional. Sent as `Authorization: Bearer ...` on the call
# above.
OTP_WEBHOOK_TOKEN=""

# OTP_DEV_ECHO: Local development only. "true" shows the code on screen instead
# of emailing it, so the flow can be tried without a mail provider. Refused
# outright when NODE_ENV=production.
OTP_DEV_ECHO="false"

# GOOGLE_CLIENT_ID: Optional. OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services > Credentials).
# Without it the server and the browser both fall back to the built-in client ID
# in src/config/google.ts, so Google sign-in keeps working end to end.
# Enables the "Sign in with Google" button on the login/signup screens. Add your site origins
# (e.g. http://localhost:3000 and your production URL) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Server-only Upstox credentials. Generate in Upstox Developer Apps.
# Replace expired tokens and restart the server. Never use a VITE_ prefix.
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_ACCESS_TOKEN=""

# Leave at 0 almost everywhere. A proxy on the same machine or a private
# network (how hosts like Hostinger serve Node apps) is recognised on its own,
# so each visitor is counted separately. Set an exact hop count only if your
# proxy reaches the app from a public address.
TRUST_PROXY_HOPS=0
