# The backups and set-aside unreadable copies the JSON store keeps beside each file.
data/*.bak
data/*.corrupt-*
# Local agent state stays out, but skills are shared instructions for anyone
# working in this repo, so they are tracked. Git will not descend into an
# excluded directory, so the contents are excluded rather than the directory.
.claude/*
!.claude/skills/
